# Set these in your shell; no dotenv loader is required.
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/novels.sqlite
# Unset: admin login disabled. 必ず十分に長いランダムな値に変更してください。
# Public deployment (PUBLIC_ORIGIN or COOKIE_SECURE=1) requires >=12 characters.
# ADMIN_PASSWORD=<your-random-admin-password>
# Optional override, >=32 characters. Otherwise a random key is persisted in DB.
# COOKIE_SECRET=<your-random-signing-secret-at-least-32-characters>
# Reverse proxy / non-loopback access requires this exact public origin.
# PUBLIC_ORIGIN=https://example.com
# COOKIE_SECURE=1

# Only enable behind trusted proxies that overwrite incoming X-Forwarded-For.
# Block direct public access to the app. Hops counts from the right of XFF.
# TRUST_PROXY=1
# TRUST_PROXY_HOPS=1
# Production: set COOKIE_SECRET separately from DB backups.
# Reuse app_meta cookie_secret value when migrating to preserve existing cookies.

# Workers版は .dev.vars.example / README のWorkers節を参照。DB_PATH/TRUST_PROXYはNode版専用。

# Site-wide unfinished-book cap (administrators included).
MAX_ACTIVE_NOVELS=3

# Guest creation lengths; administrators can always create all three lengths.
# Enable long novels: 4000,12000,40000. Existing books are unaffected.
ENABLED_CAPACITIES=4000,12000
