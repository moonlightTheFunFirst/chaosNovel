# Set these in your shell; no dotenv loader is required.
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/novels.sqlite
# Default: everyone using this local server is an administrator.
# Set 0 to restore normal one-post participation and disable book deletion.
ADMIN_MODE=1
# For HTTPS reverse proxies set the exact public origin and secure cookies.
# PUBLIC_ORIGIN=https://example.com
# COOKIE_SECURE=1
