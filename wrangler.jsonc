{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaos-novel",
  "account_id": "dbc9245da5cda5dbb571a880d6e957db",
  "main": "workers/index.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".workers-assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/novels/*"],
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://chaos-novel.tazn.workers.dev",
    "COOKIE_SECURE": "1",
    "MAX_ACTIVE_NOVELS": "10",
    "ENABLED_CAPACITIES": "4000,12000",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chaos-novel-db",
      "database_id": "236f2eab-1248-4ef1-aa3e-55b74ecbc931",
      "migrations_dir": "workers/migrations",
    },
  ],
  "env": {
    "local": {
      "name": "chaos-novel-local",
      "vars": {
        "PUBLIC_ORIGIN": "http://127.0.0.1:8787",
        "COOKIE_SECURE": "0",
        "LOCAL_DEV": "1",
        "MAX_ACTIVE_NOVELS": "30",
        "ENABLED_CAPACITIES": "4000,12000",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "chaos-novel-local",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "workers/migrations",
        },
      ],
    },
  },
}
