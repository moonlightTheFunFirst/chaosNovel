# Set these in your shell; no dotenv loader is required.
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/novels.sqlite
# Development password requested for this prototype; change for public use.
ADMIN_PASSWORD=1234
# Use a stable, randomly generated secret for persistent participant cookies.
# COOKIE_SECRET=replace-with-a-long-random-secret
# For a reverse proxy / non-loopback host, specify the exact public origin.
# PUBLIC_ORIGIN=https://example.com
# COOKIE_SECURE=1
